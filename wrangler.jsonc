{
  // Static-asset-only Worker: no server code, Cloudflare serves the files in public/.
  "name": "marvellous",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./public",
    // /about -> /about.html, and /about.html redirects to the clean URL
    "html_handling": "auto-trailing-slash",
    // unknown paths render public/404.html with a 404 status
    "not_found_handling": "404-page"
  }
}
